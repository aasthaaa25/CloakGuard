[Unit]
Description=CloakGuard forward-only reverse proxy
After=network.target

[Service]
Type=simple
User=defaceguard
WorkingDirectory=/opt/cloakguard/results
EnvironmentFile=/etc/cloakguard/proxy.env
ExecStart=/opt/cloakguard/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --no-proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
